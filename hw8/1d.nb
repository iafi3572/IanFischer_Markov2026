Cell["\<\
\\left(
\\begin{array}{cccc}
 \\text{y1}(t)=\\frac{1}{12} e^{-2 t} \\left(3 e^{2
   t}-4 e^t \\sin (t)+2 e^t \\cos (t)-1\\right) &
   \\text{y2}(t)=\\frac{1}{12} e^{-2 t} \\left(3 e^{2
   t}+2 e^t \\sin (t)+4 e^t \\cos (t)+1\\right) &
   \\text{y3}(t)=\\frac{1}{12} e^{-2 t} \\left(3 e^{2
